---
import type { CollectionEntry } from 'astro:content';

interface Props {
	role: CollectionEntry<'roles'>;
}

const { role } = Astro.props;
const { company, title, location, startDate, endDate, summary } = role.data;
---

<div class="role-row">
	<div class="role-dates">
		<p>{startDate} – {endDate ?? 'Present'}</p>
	</div>
	<div class="role-body">
		<h3>{title} — {company}</h3>
		<p class="meta">{location}</p>
		<p>{summary}</p>
	</div>
</div>

<style>
	.role-row {
		display: grid;
		grid-template-columns: 160px 1fr;
		gap: var(--space-8);
		padding: var(--space-6) 0;
	}

	.role-row + .role-row {
		border-top: var(--rule-width) solid var(--rule);
	}

	.role-dates p {
		color: var(--muted);
		font-size: var(--text-sm);
		margin: 0;
	}

	.role-body h3 {
		margin-bottom: var(--space-1);
	}

	.role-body .meta {
		color: var(--muted);
		font-size: var(--text-sm);
		margin: 0 0 var(--space-2);
	}

	.role-body p:last-child {
		margin-bottom: 0;
	}

	@media (max-width: 700px) {
		.role-row {
			grid-template-columns: 1fr;
			gap: var(--space-2);
		}
	}
</style>
