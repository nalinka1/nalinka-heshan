---
// Deploy pipeline diagram for /architecture, under "Deploys".
//
// Layout is computed, not hand-plotted: box widths come from an estimated
// text width per label so the diagram stays easy to edit (change a label,
// the boxes reflow) without reaching for Mermaid or an exported image —
// still plain SVG, no build step, no client JS.
import Diagram from './Diagram.astro';

interface Part {
	text: string;
	mono?: boolean;
}

interface NodeDef {
	id: string;
	/** Desktop label, possibly wrapped across lines. */
	deskLines: Part[][];
	/** Mobile label — one line where the narrow stacked boxes are wide enough for it. */
	mobileLines: Part[][];
	/** True if the arrow (and box outline) leading INTO this node is part of the
	 * token-exchange path and gets --accent instead of --ink. */
	accentIn?: boolean;
}

const nodes: NodeDef[] = [
	{
		id: 'push',
		deskLines: [[{ text: 'push to' }], [{ text: 'master', mono: true }]],
		mobileLines: [[{ text: 'push to ' }, { text: 'master', mono: true }]],
	},
	{
		id: 'actions',
		deskLines: [[{ text: 'GitHub' }], [{ text: 'Actions' }]],
		mobileLines: [[{ text: 'GitHub Actions' }]],
	},
	{
		id: 'oidc',
		deskLines: [[{ text: 'OIDC token' }], [{ text: 'request' }]],
		mobileLines: [[{ text: 'OIDC token request' }]],
		accentIn: true,
	},
	{
		// The temporary credentials are the output of this call, not a separate step.
		id: 'sts',
		deskLines: [[{ text: 'STS AssumeRole' }], [{ text: 'WithWebIdentity' }], [{ text: '→ temp credentials' }]],
		mobileLines: [[{ text: 'STS AssumeRoleWithWebIdentity' }], [{ text: '→ temp credentials' }]],
		accentIn: true,
	},
	{
		id: 's3',
		deskLines: [[{ text: 'S3 sync' }]],
		mobileLines: [[{ text: 'S3 sync' }]],
	},
	{
		id: 'cloudfront',
		deskLines: [[{ text: 'CloudFront' }], [{ text: 'invalidation' }]],
		mobileLines: [[{ text: 'CloudFront invalidation' }]],
	},
	{
		id: 'viewer',
		deskLines: [[{ text: 'viewer' }]],
		mobileLines: [[{ text: 'viewer' }]],
	},
];

// Rough glyph widths at 12px IBM Plex Sans/Mono — good enough to size boxes
// that fit their labels without measuring text at build time.
const CHAR_W = 6.3;
const MONO_CHAR_W = 6.8;
const lineWidth = (parts: Part[], fontSize = 12) =>
	parts.reduce((sum, p) => sum + p.text.length * (p.mono ? MONO_CHAR_W : CHAR_W), 0) * (fontSize / 12);

// Smallest label a reader may ever see, in CSS px (PHASE_3_PLAN.md).
const MIN_LABEL_PX = 12;

// --- Desktop: left to right ---------------------------------------------
// The viewBox is as wide as the content column at --page-max (60rem minus
// 2 × --space-6 padding), so at full width one user unit is one CSS pixel
// and the row fills the column edge to edge.
const D_WIDTH = 912;
const D_FONT = 14;
const D_PAD_X = 14;
const D_PAD_Y = 14;
const D_MIN_W = 84;
const D_GAP = 28;
const D_EDGE = 1; // half the stroke width, so the outer box edges don't clip
const D_LINE_H = 18;
const D_BOX_H = Math.max(...nodes.map((n) => n.deskLines.length)) * D_LINE_H + D_PAD_Y * 2;

const naturalWidths = nodes.map((n) =>
	Math.max(D_MIN_W, Math.max(...n.deskLines.map((l) => lineWidth(l, D_FONT))) + D_PAD_X * 2),
);
const spare = D_WIDTH - D_EDGE * 2 - D_GAP * (nodes.length - 1) - naturalWidths.reduce((a, b) => a + b, 0);
if (spare < 0) {
	throw new Error(`DeployPipeline: desktop labels overflow the row by ${Math.ceil(-spare)} units`);
}

// Leftover width goes evenly to every box, so the row spans the full column.
let cursorX = D_EDGE;
const desktopBoxes = nodes.map((n, i) => {
	const w = naturalWidths[i] + spare / nodes.length;
	const box = { node: n, x: cursorX, y: D_EDGE, w, h: D_BOX_H };
	cursorX += w + D_GAP;
	return box;
});

const desktopEdges = desktopBoxes.slice(1).map((box, i) => ({
	x1: desktopBoxes[i].x + desktopBoxes[i].w,
	x2: box.x,
	y: box.y + box.h / 2,
	accent: !!box.node.accentIn,
}));

// Cloudflare sits below the row, near the viewer end — connected by a thin
// dashed line with no arrowhead, since it's not a step in the request path.
const D_CF_W = lineWidth([{ text: 'resolves DNS' }], D_FONT) + D_PAD_X * 2;
const D_CF_H = D_LINE_H * 2 + 24;
const viewerBox = desktopBoxes[desktopBoxes.length - 1];
const cfBoxDesktop = {
	x: viewerBox.x + viewerBox.w / 2 - D_CF_W - 20,
	y: D_EDGE + D_BOX_H + 40,
	w: D_CF_W,
	h: D_CF_H,
};
const desktopHeight = cfBoxDesktop.y + cfBoxDesktop.h + D_EDGE;
const desktopViewBox = `0 0 ${D_WIDTH} ${desktopHeight}`;

// Below this viewport width the row would scale labels under MIN_LABEL_PX, so
// the stacked layout takes over. 48 = the page's side padding (2 × --space-6).
const stackBelow = Math.ceil((D_WIDTH * MIN_LABEL_PX) / D_FONT) + 48;

// --- Mobile: stacked top to bottom, arrows pointing down -----------------
const M_WIDTH = 300;
const M_BOX_H = 44;
const M_BOX_W = M_WIDTH - 48;
const M_GAP = 34;
const M_MARGIN = 24;
const M_LINE_H = 15;

let cursorY = M_MARGIN;
const mobileBoxes = nodes.map((n) => {
	const h = M_BOX_H + (n.mobileLines.length - 1) * M_LINE_H;
	const box = { node: n, x: (M_WIDTH - M_BOX_W) / 2, y: cursorY, w: M_BOX_W, h };
	cursorY += h + M_GAP;
	return box;
});

const mobileEdges = mobileBoxes.slice(1).map((box, i) => ({
	y1: mobileBoxes[i].y + mobileBoxes[i].h,
	y2: box.y,
	x: box.x + box.w / 2,
	accent: !!box.node.accentIn,
}));

const M_CF_W = 180;
const M_CF_H = 54;
const mViewerBox = mobileBoxes[mobileBoxes.length - 1];
const cfBoxMobile = {
	x: mViewerBox.x + mViewerBox.w - M_CF_W,
	y: cursorY - M_GAP + 44,
	w: M_CF_W,
	h: M_CF_H,
};
const mobileHeight = cfBoxMobile.y + cfBoxMobile.h + D_EDGE;
const mobileViewBox = `0 0 ${M_WIDTH} ${mobileHeight}`;

const desc =
	'Push to master triggers GitHub Actions, which requests an OIDC token from GitHub, ' +
	'exchanges it with AWS STS for temporary credentials, syncs the build to S3, and ' +
	'invalidates CloudFront. A viewer then loads the site from CloudFront. Cloudflare ' +
	'resolves DNS for the domain separately, outside this request path.';
---

<Diagram
	id="deploy-pipeline"
	viewBox={desktopViewBox}
	mobileViewBox={mobileViewBox}
	stackBelow={stackBelow}
	title="How a push to master reaches a viewer, with no stored AWS credentials"
	desc={desc}
>
	<defs>
		<marker id="dp-arrow-ink" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto">
			<path d="M0,0 L8,4 L0,8 Z" class="arrow arrow--ink" />
		</marker>
		<marker id="dp-arrow-accent" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto">
			<path d="M0,0 L8,4 L0,8 Z" class="arrow arrow--accent" />
		</marker>
	</defs>

	{desktopEdges.map((e) => (
		<line
			x1={e.x1}
			y1={e.y}
			x2={e.x2 - 2}
			y2={e.y}
			class={`edge ${e.accent ? 'edge--accent' : 'edge--ink'}`}
			marker-end={`url(#dp-arrow-${e.accent ? 'accent' : 'ink'})`}
		/>
	))}

	<line
		x1={cfBoxDesktop.x + cfBoxDesktop.w / 2}
		y1={cfBoxDesktop.y}
		x2={viewerBox.x + viewerBox.w / 2}
		y2={viewerBox.y + viewerBox.h}
		class="connector"
	/>

	{desktopBoxes.map((box) => (
		<g>
			<rect
				x={box.x}
				y={box.y}
				width={box.w}
				height={box.h}
				rx="4"
				class={`box ${box.node.accentIn ? 'box--accent' : ''}`}
			/>
			<text
				x={box.x + box.w / 2}
				y={box.y + box.h / 2 - ((box.node.deskLines.length - 1) * D_LINE_H) / 2}
				font-size={D_FONT}
				class="label"
			>
				{box.node.deskLines.map((line, i) => (
					<tspan x={box.x + box.w / 2} dy={i === 0 ? 0 : D_LINE_H}>
						{line.map((part) => (
							<tspan class={part.mono ? 'mono-part' : undefined}>{part.text}</tspan>
						))}
					</tspan>
				))}
			</text>
		</g>
	))}

	<g>
		<rect x={cfBoxDesktop.x} y={cfBoxDesktop.y} width={cfBoxDesktop.w} height={cfBoxDesktop.h} rx="4" class="box box--satellite" />
		<text
			x={cfBoxDesktop.x + cfBoxDesktop.w / 2}
			y={cfBoxDesktop.y + cfBoxDesktop.h / 2 - D_LINE_H / 2}
			font-size={D_FONT}
			class="label label--muted"
		>
			<tspan x={cfBoxDesktop.x + cfBoxDesktop.w / 2} dy="0">Cloudflare</tspan>
			<tspan x={cfBoxDesktop.x + cfBoxDesktop.w / 2} dy={D_LINE_H}>resolves DNS</tspan>
		</text>
	</g>

	<Fragment slot="mobile">
		<defs>
			<marker id="dp-m-arrow-ink" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M0,0 L8,4 L0,8 Z" class="arrow arrow--ink" />
			</marker>
			<marker id="dp-m-arrow-accent" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M0,0 L8,4 L0,8 Z" class="arrow arrow--accent" />
			</marker>
		</defs>

		{mobileEdges.map((e) => (
			<line
				x1={e.x}
				y1={e.y1}
				x2={e.x}
				y2={e.y2 - 2}
				class={`edge ${e.accent ? 'edge--accent' : 'edge--ink'}`}
				marker-end={`url(#dp-m-arrow-${e.accent ? 'accent' : 'ink'})`}
			/>
		))}

		<line
			x1={cfBoxMobile.x + cfBoxMobile.w / 2}
			y1={cfBoxMobile.y}
			x2={mViewerBox.x + mViewerBox.w / 2}
			y2={mViewerBox.y + mViewerBox.h}
			class="connector"
		/>

		{mobileBoxes.map((box) => (
			<g>
				<rect
					x={box.x}
					y={box.y}
					width={box.w}
					height={box.h}
					rx="4"
					class={`box ${box.node.accentIn ? 'box--accent' : ''}`}
				/>
				<text x={box.x + box.w / 2} y={box.y + box.h / 2 - ((box.node.mobileLines.length - 1) * M_LINE_H) / 2} class="label">
					{box.node.mobileLines.map((line, i) => (
						<tspan x={box.x + box.w / 2} dy={i === 0 ? 0 : M_LINE_H}>
							{line.map((part) => (
								<tspan class={part.mono ? 'mono-part' : undefined}>{part.text}</tspan>
							))}
						</tspan>
					))}
				</text>
			</g>
		))}

		<g>
			<rect x={cfBoxMobile.x} y={cfBoxMobile.y} width={cfBoxMobile.w} height={cfBoxMobile.h} rx="4" class="box box--satellite" />
			<text x={cfBoxMobile.x + cfBoxMobile.w / 2} y={cfBoxMobile.y + cfBoxMobile.h / 2 - M_LINE_H / 2} class="label label--muted">
				<tspan x={cfBoxMobile.x + cfBoxMobile.w / 2} dy="0">Cloudflare</tspan>
				<tspan x={cfBoxMobile.x + cfBoxMobile.w / 2} dy={M_LINE_H}>resolves DNS</tspan>
			</text>
		</g>
	</Fragment>

	<Fragment slot="caption">
		The accent path is the only place a credential exists — a short-lived token exchanged
		for temporary STS credentials, never stored.
	</Fragment>
</Diagram>

<style>
	.box {
		fill: var(--diagram-fill);
		stroke: var(--ink);
		stroke-width: 1.5;
	}

	.box--accent {
		stroke: var(--accent);
	}

	.box--satellite {
		stroke: var(--rule);
		stroke-dasharray: 3 3;
	}

	.edge {
		stroke-width: 1.5;
	}

	.edge--ink {
		stroke: var(--ink);
	}

	.edge--accent {
		stroke: var(--accent);
	}

	.connector {
		stroke: var(--rule);
		stroke-width: 1;
		stroke-dasharray: 4 4;
	}

	.arrow--ink {
		fill: var(--ink);
	}

	.arrow--accent {
		fill: var(--accent);
	}

	.label {
		fill: var(--ink);
		text-anchor: middle;
		dominant-baseline: middle;
	}

	.label--muted {
		fill: var(--muted);
	}

	.mono-part {
		font-family: var(--font-mono);
	}
</style>
