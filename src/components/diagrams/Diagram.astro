---
// Shared wrapper for hand-written SVG diagrams. Handles the accessible
// scaffolding (role, title, desc), the caption, and responsive sizing —
// each diagram component only supplies the boxes/lines/labels as its
// default slot (and an optional "mobile" slot for the stacked variant
// below `stackBelow`, 700px by default, per PHASE_3_PLAN.md's mobile rules).

interface Props {
	/** Unique slug for this diagram instance — becomes the id prefix for title/desc. */
	id: string;
	/** SVG viewBox for the default (desktop) layout, e.g. "0 0 800 300". */
	viewBox: string;
	/** SVG viewBox for the stacked vertical layout shown below `stackBelow`. Omit if the
	 * diagram doesn't need restacking. */
	mobileViewBox?: string;
	/** Viewport width in px below which the stacked layout replaces the desktop one.
	 * Set it where the desktop layout would scale its labels under 12px. */
	stackBelow?: number;
	/** Accessible name — becomes the SVG <title>. */
	title: string;
	/** Accessible long description — becomes the SVG <desc>. Should carry the same
	 * facts as the surrounding prose, never a fact that exists only in the picture. */
	desc: string;
}

const { id, viewBox, mobileViewBox, stackBelow = 700, title, desc } = Astro.props;

const viewBoxSize = (vb: string) => {
	const [, , w, h] = vb.trim().split(/\s+/).map(Number);
	return { w, h };
};
const aspectRatio = (vb: string) => {
	const { w, h } = viewBoxSize(vb);
	return `${w} / ${h}`;
};

// Per-diagram breakpoint — media queries can't read a prop, so the rule is
// generated and scoped to this figure's id.
const stackRule =
	`@media (max-width: ${stackBelow}px) {` +
	`#${id} .diagram-svg--desktop { display: none; }` +
	`#${id} .diagram-svg--mobile { display: block; }` +
	`}`;

const titleId = `${id}-title`;
const descId = `${id}-desc`;
const hasCaption = Astro.slots.has('caption');
---

<figure class="diagram" id={id}>
	<svg
		class="diagram-svg diagram-svg--desktop"
		viewBox={viewBox}
		style={`aspect-ratio: ${aspectRatio(viewBox)};`}
		role="img"
		aria-labelledby={`${titleId} ${descId}`}
		preserveAspectRatio="xMidYMid meet"
	>
		<title id={titleId}>{title}</title>
		<desc id={descId}>{desc}</desc>
		<slot />
	</svg>

	{mobileViewBox && (
		<svg
			class="diagram-svg diagram-svg--mobile"
			viewBox={mobileViewBox}
			style={`aspect-ratio: ${aspectRatio(mobileViewBox)}; max-width: ${viewBoxSize(mobileViewBox).w}px;`}
			role="img"
			aria-labelledby={`${titleId} ${descId}`}
			preserveAspectRatio="xMidYMid meet"
		>
			<slot name="mobile" />
		</svg>
	)}

	{mobileViewBox && <style is:inline set:html={stackRule} />}

	{hasCaption && (
		<figcaption>
			<slot name="caption" />
		</figcaption>
	)}
</figure>

<style>
	.diagram {
		margin: var(--space-8) 0;
	}

	.diagram-svg {
		display: block;
		width: 100%;
		height: auto;
		font-family: var(--font-sans);
		font-size: var(--diagram-label-size);
	}

	.diagram-svg--mobile {
		display: none;
	}

	figcaption {
		margin-top: var(--space-2);
		font-size: var(--text-sm);
		color: var(--muted);
	}

	/* Shared element styles for every diagram's boxes, edges and labels. They're
	   :global because the elements come from each diagram component's slot. */
	.diagram :global(.box) {
		fill: var(--diagram-fill);
		stroke: var(--ink);
		stroke-width: 1.5;
	}

	.diagram :global(.box--accent) {
		stroke: var(--accent);
	}

	.diagram :global(.box--satellite) {
		stroke: var(--rule);
		stroke-dasharray: 3 3;
	}

	.diagram :global(.edge) {
		stroke-width: 1.5;
	}

	.diagram :global(.edge--ink) {
		stroke: var(--ink);
	}

	.diagram :global(.edge--accent) {
		stroke: var(--accent);
	}

	.diagram :global(.connector) {
		stroke: var(--rule);
		stroke-width: 1;
		stroke-dasharray: 4 4;
	}

	.diagram :global(.arrow--ink) {
		fill: var(--ink);
	}

	.diagram :global(.arrow--accent) {
		fill: var(--accent);
	}

	.diagram :global(.label) {
		fill: var(--ink);
		text-anchor: middle;
		dominant-baseline: middle;
	}

	.diagram :global(.label--muted) {
		fill: var(--muted);
	}

	.diagram :global(.mono-part) {
		font-family: var(--font-mono);
	}
</style>
