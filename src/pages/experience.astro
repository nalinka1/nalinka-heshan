---
import BaseLayout from '../layouts/BaseLayout.astro';
import RoleRow from '../components/RoleRow.astro';
import { getCollection } from 'astro:content';

const roles = (await getCollection('roles')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
	title="Experience — Nalinka Heshan"
	description="Nalinka Heshan's work history: Transport Accident Commission, Cloud Solutions International, Qbitum Solution, and Zilingo."
>
	<h1>Experience</h1>
	<section aria-label="Experience">
		{roles.map((role) => <RoleRow role={role} />)}
	</section>
	<p class="cv-link"><a href="/cv.pdf">CV (PDF)</a></p>
</BaseLayout>

<style>
	.cv-link {
		margin-top: var(--space-8);
	}
</style>
