---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import { isPublished } from '../../lib/published';

export async function getStaticPaths() {
	const projects = await getCollection('projects', ({ data }) => isPublished(data.body));
	return projects.map((project) => ({
		params: { slug: project.data.slug },
		props: { project },
	}));
}

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, stack, repo, images = [] } = project.data;
const body = project.data.body!;
---

<BaseLayout title={`${title} — Nalinka Heshan`} description={body.whatItIs}>
	<p class="back"><a href="/projects">← Projects</a></p>
	{body.draft && <p class="draft-note">Draft — only visible in local dev, not on the live site.</p>}
	<h1>{title}</h1>

	<section aria-labelledby="what-it-is-heading">
		<h2 id="what-it-is-heading">What it is</h2>
		<p>{body.whatItIs}</p>
		{images.map((img) => (
			<figure class="project-image">
				<Image
					src={img.src}
					alt={img.alt}
					widths={[480, 960, 1920]}
					sizes="(max-width: 60rem) 100vw, 60rem"
					format="webp"
					loading="lazy"
				/>
				{img.caption && <figcaption>{img.caption}</figcaption>}
			</figure>
		))}
	</section>

	{body.built && (
		<section aria-labelledby="built-heading">
			<h2 id="built-heading">What I built</h2>
			<ul class="built">
				{body.built.map((item) => <li>{item}</li>)}
			</ul>
		</section>
	)}

	{body.decisions && (
		<section aria-labelledby="decisions-heading">
			<h2 id="decisions-heading">Decisions</h2>
			{body.decisions.map((item) => (
				<article class="decision">
					<h3>{item.decision}</h3>
					<p class="rejected">Rejected: {item.rejected}</p>
					<p>{item.why}</p>
				</article>
			))}
		</section>
	)}

	{body.whatBroke && (
		<section aria-labelledby="what-broke-heading">
			<h2 id="what-broke-heading">What broke</h2>
			<p>{body.whatBroke}</p>
		</section>
	)}

	<section aria-labelledby="stack-heading">
		<h2 id="stack-heading">Stack</h2>
		<p class="mono">{stack.join(' · ')}</p>
		{repo && <p><a href={repo}>{repo.replace('https://', '')}</a></p>}
	</section>
</BaseLayout>

<style>
	.back {
		margin-bottom: var(--space-8);
	}

	h1 {
		margin-bottom: var(--space-8);
	}

	h2,
	h3 {
		margin-bottom: var(--space-2);
	}

	section + section {
		margin-top: var(--space-8);
		padding-top: var(--space-8);
		border-top: var(--rule-width) solid var(--rule);
	}

	.decision + .decision {
		margin-top: var(--space-6);
	}

	.project-image {
		margin: var(--space-8) 0;
	}

	.project-image img {
		display: block;
		max-width: 100%;
		height: auto;
	}

	.project-image figcaption {
		margin-top: var(--space-2);
		font-size: var(--text-sm);
		color: var(--muted);
	}

	.draft-note {
		font-size: var(--text-sm);
		color: var(--accent);
		border-left: 2px solid var(--accent);
		padding-left: var(--space-3);
	}

	.built {
		margin: 0;
		padding-left: var(--space-6);
		max-width: var(--measure);
	}

	.built li + li {
		margin-top: var(--space-2);
	}

	.rejected {
		color: var(--muted);
		font-size: var(--text-sm);
		margin: 0 0 var(--space-2);
	}
</style>
