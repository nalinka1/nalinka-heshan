---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
	title="Projects — Nalinka Heshan"
	description="Projects by Nalinka Heshan: an event-driven AWS order platform, a multi-cloud secure document platform on Azure, and a computer vision LEGO sorting system."
>
	<h1>Projects</h1>
	<section aria-label="Projects">
		{projects.map((project) => <ProjectRow project={project} />)}
	</section>
</BaseLayout>
